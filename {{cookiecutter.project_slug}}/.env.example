DJANGO_SETTINGS_MODULE=__PROJECT_PACKAGE__.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_HSTS_SECONDS=0

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PHONE=
DJANGO_SUPERUSER_PASSWORD=change-me-before-deploy

LOG_LEVEL=INFO
DJANGO_AUTORELOAD_LOG_LEVEL=INFO
LOG_COLORIZE=True
LOG_FILE_ENABLED=True
LOG_FILE_PATH=logs/app.log
LOG_ASYNC_FILE_PATH=logs/async.log
LOG_ERROR_FILE_PATH=logs/error.log
LOG_ROTATION=100 MB
LOG_RETENTION=14 days
LOG_COMPRESSION=gz
LOG_BACKTRACE=False
LOG_DIAGNOSE=False

DB_ENGINE=sqlite
DB_NAME=django_framework
DB_USER=django
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUTH_VERIFICATION_REDIS_URL=redis://localhost:6379/2

AUTH_STYLE=picture
# 认证页媒体支持 picture 或 video（兼容历史拼写 vedio）。
AUTH_LOGIN_MEDIA=accounts/brand/logo.png
AUTH_REGISTER_MEDIA=accounts/brand/logo.png
AUTH_PASSWORD_RESET_MEDIA=accounts/brand/logo.png
AUTH_REMEMBER_SECONDS=2592000
AUTH_RESET_GRANT_SECONDS=600
AUTH_CODE_TTL=300
AUTH_CODE_COOLDOWN=60
AUTH_CODE_MAX_ATTEMPTS=5
# False 时验证码固定且不访问 Redis、Celery 或第三方 Provider。
USE_THIRD_PARTY_SERVICES=False
AUTH_FIXED_SMS_CODE=246810
AUTH_FIXED_EMAIL_CODE=135790

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REQUEST_TIMEOUT=10
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_EMAIL_ENDPOINT=https://dm.aliyuncs.com/
ALIYUN_EMAIL_ACCOUNT_NAME=

# AI 集成（默认关闭真实调用，仅用于开发/测试 mock）
AI_ENABLE_REAL_CALLS=False
AI_DEFAULT_PROVIDER=volcano_ark
AI_VOLCANO_API_KEY=
AI_VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_VOLCANO_DEFAULT_MODEL=doubao-seedance-1-5-pro-251215
# 仅用于向第三方公开参考图片；本地文生视频和结果保存到 media 不需要配置。
AI_MEDIA_BASE_URL=
AI_TASK_POLL_INTERVAL_SECONDS=3
AI_TASK_MAX_POLL_SECONDS=600
AI_TASK_RESULT_STORAGE=ai_results/
